  <builders>
    <hudson.tasks.Shell>
      <command>#!/bin/bash
# Simple Git Branch Operations Script

set -e  # stop the script if any command fails

# Step 1: Create a new branch
echo &quot;=== Creating branch: feature_branch ===&quot;
git checkout -b feature_branch

# Step 2: List all branches
echo &quot;=== Listing all branches ===&quot;
git branch -a

# Step 3: Merge feature_branch into main
echo &quot;=== Merging feature_branch into main ===&quot;
git checkout main
git merge feature_branch

# Step 4: Rebase feature_branch onto main
echo &quot;=== Rebasing feature_branch onto main ===&quot;
git checkout feature_branch
git rebase main

# Step 5: Delete feature_branch
echo &quot;=== Deleting feature_branch ===&quot;
git checkout main
git branch -d feature_branch

echo &quot;✅ All Git operations completed successfully&quot;</command>
